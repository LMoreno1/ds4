@model Parcial3.Models.Clientes

@{
    ViewBag.Title = "Detalles del Cliente";
}

<h2>Detalles del Cliente</h2>

<div>
    <hr />
    <dl class="dl-horizontal">
        <dt>@Html.DisplayNameFor(m => m.Nombre)</dt>
        <dd>@Html.DisplayFor(m => m.Nombre)</dd>

        <dt>@Html.DisplayNameFor(m => m.Apellido)</dt>
        <dd>@Html.DisplayFor(m => m.Apellido)</dd>

        <dt>@Html.DisplayNameFor(m => m.Identificacion)</dt>
        <dd>@Html.DisplayFor(m => m.Identificacion)</dd>

        <dt>@Html.DisplayNameFor(m => m.Telefono)</dt>
        <dd>@Html.DisplayFor(m => m.Telefono)</dd>

        <dt>@Html.DisplayNameFor(m => m.Email)</dt>
        <dd>@Html.DisplayFor(m => m.Email)</dd>

        <dt>@Html.DisplayNameFor(m => m.Direccion)</dt>
        <dd>@Html.DisplayFor(m => m.Direccion)</dd>

        <dt>@Html.DisplayNameFor(m => m.TipoCliente)</dt>
        <dd>@Html.DisplayFor(m => m.TipoCliente)</dd>

        <dt>@Html.DisplayNameFor(m => m.FechaRegistro)</dt>
        <dd>@Model.FechaRegistro.ToString("dd/MM/yyyy HH:mm")</dd>
    </dl>
</div>

<div>
    <h3>Casos del Cliente</h3>
    @if (ViewBag.Casos != null && ((List<Parcial3.Models.Casos>)ViewBag.Casos).Count > 0)
    {
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Número de Caso</th>
                    <th>Título</th>
                    <th>Estado</th>
                    <th>Abogado</th>
                    <th>Fecha Inicio</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var caso in (List<Parcial3.Models.Casos>)ViewBag.Casos)
                {
                    <tr>
                        <td>@caso.NumeroCaso</td>
                        <td>@caso.Titulo</td>
                        <td><span class="badge badge-info">@caso.Estado</span></td>
                        <td>@(caso.Abogado != null ? caso.Abogado.NombreCompleto : "N/A")</td>
                        <td>@caso.FechaInicio.ToString("dd/MM/yyyy")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p class="text-muted">Este cliente no tiene casos registrados.</p>
    }
</div>

<p>
    @Html.ActionLink("Editar", "Edit", new { id = Model.ClienteID }, new { @class = "btn btn-warning" })
    @Html.ActionLink("Regresar", "Index", null, new { @class = "btn btn-default" })
</p>